<!DOCTYPE html>
<html lang="en" class="h-full bg-zinc-950 text-zinc-300 antialiased">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ZipVault Workspace</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <style>
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #3f3f46; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #52525b; }
  </style>
</head>
<body class="h-full flex flex-col font-sans overflow-hidden selection:bg-indigo-500/30">
  
  <!-- Premium Top Navigation -->
  <header class="h-14 border-b border-zinc-800 bg-zinc-950 px-5 flex items-center justify-between shrink-0 shadow-sm z-10">
    <div class="flex items-center space-x-4">
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="bg-indigo-500/10 p-1.5 rounded-lg border border-indigo-500/20 group-hover:bg-indigo-500/20 transition-colors">
          <i data-lucide="box" class="w-4 h-4 text-indigo-400"></i>
        </div>
        <span class="font-semibold text-sm text-zinc-100 tracking-wide">ZipVault</span>
      </a>
      <div class="h-4 w-[1px] bg-zinc-800"></div>
      <span class="text-[11px] font-medium uppercase tracking-wider text-zinc-500">Workspace</span>
    </div>

    <!-- Header Archive Meta / ZipVault Analysis Result Layout -->
    <div id="archiveMeta" class="hidden flex items-center bg-zinc-900 border border-zinc-800 rounded-full px-3 py-1.5 shadow-inner text-xs font-medium gap-3">
      <div class="flex items-center gap-1.5 text-zinc-300 font-semibold border-r border-zinc-800 pr-3">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>ZipVault Analysis Result</span>
      </div>
      <div class="flex items-center gap-3 text-zinc-400">
        <div class="flex items-center gap-1">
          <span class="text-zinc-500">Status:</span>
          <span class="text-emerald-400 font-medium">Analyzed successfully</span>
        </div>
        <div class="w-1 h-1 rounded-full bg-zinc-700"></div>
        <div class="flex items-center gap-1">
          <span class="text-zinc-500">Files:</span>
          <span id="archiveEntries" class="text-zinc-200">0</span>
        </div>
        <div class="w-1 h-1 rounded-full bg-zinc-700"></div>
        <div class="flex items-center gap-1">
          <span class="text-zinc-500">Size:</span>
          <span id="archiveSize" class="text-zinc-200">0 KB</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Main IDE Layout -->
  <main class="flex-1 flex overflow-hidden bg-zinc-950">
    
    <!-- Left Sidebar -->
    <aside class="w-72 border-r border-zinc-800 bg-zinc-900/40 flex flex-col flex-shrink-0 relative z-0">
      
      <!-- Upload Drop Area with Animation -->
      <div class="p-4 border-b border-zinc-800 bg-zinc-950/50">
        <div id="dropZone" class="group relative border-2 border-dashed border-zinc-700/60 hover:border-indigo-500/60 bg-zinc-900/50 hover:bg-indigo-500/5 rounded-xl p-5 text-center cursor-pointer transition-all duration-300 ease-out overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-b from-indigo-500/0 to-indigo-500/0 group-hover:from-indigo-500/10 group-hover:to-transparent transition-colors duration-500"></div>
          
          <i data-lucide="cloud-upload" class="w-7 h-7 mx-auto text-zinc-500 group-hover:text-indigo-400 group-hover:scale-110 transition-all duration-300 mb-2.5 relative z-10"></i>
          <p class="text-xs text-zinc-300 font-medium relative z-10">Drop `.zip` file here</p>
          <p class="text-[10px] text-zinc-500 mt-1 relative z-10">or click to browse</p>
          <input type="file" id="zipInput" accept=".zip" class="hidden" />
        </div>
      </div>

      <!-- Search Bar -->
      <div class="px-4 py-3 border-b border-zinc-800 bg-zinc-900/20">
        <div class="relative flex items-center group">
          <i data-lucide="search" class="w-3.5 h-3.5 text-zinc-500 absolute left-2.5 group-focus-within:text-indigo-400 transition-colors"></i>
          <input 
            type="text" 
            id="treeSearch" 
            placeholder="Search files..." 
            class="w-full bg-zinc-950 border border-zinc-800 focus:border-indigo-500/50 rounded-md py-1.5 pl-8 pr-3 text-xs text-zinc-200 focus:outline-none focus:ring-1 focus:ring-indigo-500/50 transition-all shadow-sm placeholder-zinc-600"
          />
        </div>
      </div>

      <!-- File Tree Explorer -->
      <div id="fileTree" class="flex-1 overflow-y-auto p-2 text-[11px] font-medium space-y-0.5 select-none">
        <div class="flex flex-col items-center justify-center h-full text-zinc-600 space-y-3">
          <i data-lucide="folder-search" class="w-8 h-8 opacity-20"></i>
          <p>No workspace loaded</p>
        </div>
      </div>
    </aside>

    <!-- Right Workspace Area -->
    <section class="flex-1 flex flex-col min-w-0 bg-zinc-950 relative">
      
      <!-- Tab Bar -->
      <div class="h-10 border-b border-zinc-800 bg-zinc-900/30 flex items-center justify-between px-4 shrink-0">
        <div class="flex items-center gap-2 text-zinc-400 max-w-[70%]">
          <i data-lucide="file-code-2" class="w-4 h-4 shrink-0"></i>
          <span id="previewPath" class="text-xs truncate">No active file</span>
        </div>

        <button 
          id="extractBtn" 
          disabled 
          class="hidden flex items-center gap-1.5 bg-indigo-500 hover:bg-indigo-400 disabled:opacity-50 text-white font-medium px-3 py-1 rounded text-[11px] transition-all shadow-sm"
        >
          <i data-lucide="download" class="w-3.5 h-3.5"></i>
          Download File
        </button>
      </div>

      <!-- Main Preview Area -->
      <div id="previewArea" class="flex-1 overflow-auto flex flex-col p-6 items-center justify-center text-zinc-600">
        <i data-lucide="eye-off" class="w-12 h-12 mb-3 opacity-20 stroke-[1.5]"></i>
        <p class="text-xs font-medium">Select a file from the sidebar to preview</p>
      </div>
      
    </section>

  </main>

  <script src="/js/app.js"></script>
</body>
</html>