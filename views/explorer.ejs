<!DOCTYPE html>
<html lang="en" class="h-full bg-zinc-950 text-zinc-300 antialiased">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ZipVault Workspace</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <style>
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #3f3f46; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #52525b; }
  </style>
</head>
<body class="h-full flex flex-col font-sans overflow-hidden selection:bg-indigo-500/30">
  
  <!-- Top Navigation Header -->
  <header class="h-16 border-b border-zinc-800/80 bg-zinc-950/80 backdrop-blur-md px-6 flex items-center justify-between shrink-0 z-10">
    <div class="flex items-center space-x-3">
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="bg-indigo-500/10 p-2 rounded-xl border border-indigo-500/20 group-hover:bg-indigo-500/20 transition-colors shadow-inner">
          <i data-lucide="box" class="w-4 h-4 text-indigo-400"></i>
        </div>
        <span class="font-bold text-sm text-zinc-100 tracking-wide">ZipVault</span>
      </a>
      <div class="h-4 w-[1px] bg-zinc-800"></div>
      <span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Workspace Explorer</span>
    </div>

    <!-- Header Archive Meta with Extra Info Button -->
    <div id="archiveMeta" class="hidden flex items-center bg-zinc-900/80 border border-zinc-800 rounded-xl px-2.5 py-1.5 shadow-inner text-xs font-medium gap-3">
      <div class="flex items-center gap-2 bg-zinc-950 px-3 py-1 rounded-lg border border-zinc-800 text-zinc-200">
        <i data-lucide="file-archive" class="w-3.5 h-3.5 text-indigo-400"></i>
        <span id="archiveName" class="truncate max-w-[130px]">archive.zip</span>
      </div>
      <div class="flex items-center gap-3 text-zinc-400 pr-1">
        <div class="flex items-center gap-1.5">
          <i data-lucide="hard-drive" class="w-3.5 h-3.5 opacity-70"></i>
          <span id="archiveSize">0 KB</span>
        </div>
        <div class="w-1 h-1 rounded-full bg-zinc-700"></div>
        <div class="flex items-center gap-1.5">
          <i data-lucide="files" class="w-3.5 h-3.5 opacity-70"></i>
          <span id="archiveEntries">0</span>
        </div>
      </div>
      <button 
        id="viewExtraInfoBtn" 
        class="bg-indigo-500/10 hover:bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 cursor-pointer shadow-sm"
      >
        <i data-lucide="info" class="w-3.5 h-3.5"></i>
        View Extra Info
      </button>
    </div>
  </header>

  <!-- Main IDE Layout -->
  <main class="flex-1 flex overflow-hidden bg-zinc-950 relative">
    
    <!-- Left Sidebar -->
    <aside class="w-72 border-r border-zinc-800/80 bg-zinc-950 flex flex-col flex-shrink-0 relative z-0">
      
      <!-- Upload Drop Area with Animation -->
      <div class="p-4 border-b border-zinc-800/80 bg-zinc-950">
        <div id="dropZone" class="group relative border-2 border-dashed border-zinc-800 hover:border-indigo-500/60 bg-zinc-900/40 hover:bg-indigo-500/5 rounded-xl p-5 text-center cursor-pointer transition-all duration-300 ease-out overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-b from-indigo-500/0 to-indigo-500/0 group-hover:from-indigo-500/10 group-hover:to-transparent transition-colors duration-500"></div>
          
          <i data-lucide="cloud-upload" class="w-7 h-7 mx-auto text-zinc-500 group-hover:text-indigo-400 group-hover:scale-110 transition-all duration-300 mb-2.5 relative z-10"></i>
          <p class="text-xs text-zinc-300 font-medium relative z-10">Drop `.zip` file here</p>
          <p class="text-[10px] text-zinc-500 mt-1 relative z-10">or click to browse</p>
          <input type="file" id="zipInput" accept=".zip" class="hidden" />
        </div>
      </div>

      <!-- Search Bar -->
      <div class="px-4 py-3 border-b border-zinc-800/80 bg-zinc-950">
        <div class="relative flex items-center group">
          <i data-lucide="search" class="w-3.5 h-3.5 text-zinc-500 absolute left-3 group-focus-within:text-indigo-400 transition-colors"></i>
          <input 
            type="text" 
            id="treeSearch" 
            placeholder="Search files..." 
            class="w-full bg-zinc-900/60 border border-zinc-800 focus:border-indigo-500/50 rounded-xl py-2 pl-9 pr-3 text-xs text-zinc-200 focus:outline-none focus:ring-1 focus:ring-indigo-500/50 transition-all shadow-sm placeholder-zinc-600"
          />
        </div>
      </div>

      <!-- File Tree Explorer -->
      <div id="fileTree" class="flex-1 overflow-y-auto p-2 text-[11px] font-medium space-y-0.5 select-none">
        <div class="flex flex-col items-center justify-center h-full text-zinc-600 space-y-3">
          <i data-lucide="folder-search" class="w-8 h-8 opacity-20"></i>
          <p>No workspace loaded</p>
        </div>
      </div>
    </aside>

    <!-- Right Workspace Area -->
    <section class="flex-1 flex flex-col min-w-0 bg-zinc-950 relative">
      
      <!-- Tab Bar -->
      <div class="h-11 border-b border-zinc-800/80 bg-zinc-950 flex items-center justify-between px-5 shrink-0">
        <div class="flex items-center gap-2.5 text-zinc-400 max-w-[70%]">
          <i data-lucide="file-code-2" class="w-4 h-4 shrink-0 text-indigo-400"></i>
          <span id="previewPath" class="text-xs truncate font-medium">No active file</span>
        </div>

        <button 
          id="extractBtn" 
          disabled 
          class="hidden flex items-center gap-1.5 bg-indigo-500 hover:bg-indigo-400 disabled:opacity-50 text-white font-medium px-3.5 py-1.5 rounded-lg text-xs transition-all shadow-sm cursor-pointer"
        >
          <i data-lucide="download" class="w-3.5 h-3.5"></i>
          Download File
        </button>
      </div>

      <!-- Main Preview Area -->
      <div id="previewArea" class="flex-1 overflow-auto flex flex-col p-6 items-center justify-center text-zinc-600">
        <i data-lucide="eye-off" class="w-12 h-12 mb-3 opacity-20 stroke-[1.5]"></i>
        <p class="text-xs font-medium">Select a file from the sidebar to preview</p>
      </div>
      
    </section>

    <!-- Upload Success Modal Overlay -->
    <div id="uploadSuccessModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 max-w-md w-full shadow-2xl text-center space-y-5">
        <div class="w-12 h-12 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center mx-auto text-indigo-400 shadow-inner">
          <i data-lucide="check-circle-2" class="w-6 h-6"></i>
        </div>
        <div class="space-y-1.5">
          <h3 class="text-sm font-bold text-zinc-100 tracking-wide uppercase">Upload Successful</h3>
          <p id="modalSuccessText" class="text-xs text-zinc-400 leading-relaxed">
            ZipVault successfully detected 0 files and 0 folders.
          </p>
        </div>
        <button 
          id="closeModalBtn" 
          class="w-full bg-indigo-500 hover:bg-indigo-400 text-white font-semibold py-2.5 rounded-xl text-xs transition-all shadow-lg shadow-indigo-500/25 cursor-pointer"
        >
          Continue to Workspace
        </button>
      </div>
    </div>

    <!-- Archive Statistics Dashboard Modal -->
    <div id="statsModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 max-w-lg w-full shadow-2xl space-y-5 text-left">
        <div class="flex items-center justify-between border-b border-zinc-800 pb-4">
          <div class="flex items-center gap-2.5">
            <div class="bg-indigo-500/10 p-2 rounded-xl border border-indigo-500/20 text-indigo-400 shadow-inner">
              <i data-lucide="bar-chart-3" class="w-4 h-4"></i>
            </div>
            <h3 class="text-xs font-bold text-zinc-100 tracking-wider uppercase">Archive Analytics Dashboard</h3>
          </div>
          <button id="closeStatsBtn" class="text-zinc-500 hover:text-zinc-300 transition-colors cursor-pointer">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>

        <div class="grid grid-cols-3 gap-3">
          <div class="bg-zinc-950 border border-zinc-800/80 rounded-xl p-3.5 text-center">
            <span class="text-[10px] text-zinc-500 uppercase tracking-wider block mb-1 font-semibold">Total Files</span>
            <span id="statFilesCount" class="text-base font-bold text-zinc-200">0</span>
          </div>
          <div class="bg-zinc-950 border border-zinc-800/80 rounded-xl p-3.5 text-center">
            <span class="text-[10px] text-zinc-500 uppercase tracking-wider block mb-1 font-semibold">Total Folders</span>
            <span id="statFoldersCount" class="text-base font-bold text-zinc-200">0</span>
          </div>
          <div class="bg-zinc-950 border border-zinc-800/80 rounded-xl p-3.5 text-center">
            <span class="text-[10px] text-zinc-500 uppercase tracking-wider block mb-1 font-semibold">Compressed Size</span>
            <span id="statCompressedSize" class="text-base font-bold text-indigo-400">0 KB</span>
          </div>
        </div>

        <div class="space-y-2.5">
          <h4 class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider">Largest Files in Archive</h4>
          <div id="statLargestFiles" class="bg-zinc-950 border border-zinc-800/80 rounded-xl p-3.5 max-h-40 overflow-y-auto space-y-2 text-xs font-mono">
            <p class="text-zinc-600 text-center py-2">No files analyzed yet.</p>
          </div>
        </div>

        <button 
          id="closeStatsFooterBtn" 
          class="w-full bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-semibold py-2.5 rounded-xl text-xs transition-all shadow-sm cursor-pointer"
        >
          Close Dashboard
        </button>
      </div>
    </div>

  </main>

  <script src="/js/app.js"></script>
</body>
</html>