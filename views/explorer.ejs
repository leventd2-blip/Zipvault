<!DOCTYPE html>
<html lang="en" class="h-full bg-neutral-950 text-neutral-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ZipVault Workspace</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
</head>
<body class="h-full flex flex-col font-sans overflow-hidden">
  
  <!-- Top Navigation Header -->
  <header class="border-b border-neutral-800 bg-neutral-900/60 px-4 py-3 flex items-center justify-between shrink-0">
    <div class="flex items-center space-x-3">
      <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
        <i data-lucide="archive" class="w-5 h-5 text-emerald-400"></i>
        <span class="font-bold text-md text-white tracking-wide">ZipVault</span>
      </a>
      <span class="text-neutral-700">/</span>
      <span class="text-xs font-mono text-neutral-400">Workspace</span>
    </div>

    <!-- Header Archive Meta -->
    <div id="archiveMeta" class="hidden flex items-center gap-4 text-xs font-mono text-neutral-400 bg-neutral-900 border border-neutral-800 px-3 py-1 rounded-md">
      <div class="flex items-center gap-1.5">
        <i data-lucide="file-archive" class="w-3.5 h-3.5 text-emerald-400"></i>
        <span id="archiveName" class="text-neutral-200 font-semibold">archive.zip</span>
      </div>
      <span class="text-neutral-700">|</span>
      <div>Size: <span id="archiveSize" class="text-neutral-200">0 KB</span></div>
      <span class="text-neutral-700">|</span>
      <div>Entries: <span id="archiveEntries" class="text-neutral-200">0</span></div>
    </div>
  </header>

  <!-- Workspace Grid Layout -->
  <main class="flex-1 grid grid-cols-12 overflow-hidden">
    
    <!-- Left Sidebar: Upload, Filter & File Tree (4 Cols) -->
    <aside class="col-span-4 border-r border-neutral-800 bg-neutral-900/30 flex flex-col overflow-hidden">
      
      <!-- Upload Drop Area -->
      <div class="p-4 border-b border-neutral-800">
        <div id="dropZone" class="border-2 border-dashed border-neutral-800 hover:border-emerald-500/50 bg-neutral-900/50 rounded-lg p-4 text-center cursor-pointer transition-colors group">
          <input type="file" id="zipInput" accept=".zip" class="hidden" />
          <i data-lucide="upload-cloud" class="w-8 h-8 mx-auto text-neutral-500 group-hover:text-emerald-400 transition-colors mb-2"></i>
          <p class="text-xs text-neutral-300 font-medium">Click or Drag & Drop `.zip` file</p>
          <p class="text-[10px] text-neutral-500 mt-1">Parsed entirely in browser client memory</p>
        </div>
      </div>

      <!-- Real-time Path Search Filter -->
      <div class="px-4 py-2 border-b border-neutral-800 flex items-center gap-2 bg-neutral-900/20">
        <i data-lucide="search" class="w-4 h-4 text-neutral-500 shrink-0"></i>
        <input 
          type="text" 
          id="treeSearch" 
          placeholder="Filter archive paths..." 
          class="w-full bg-transparent text-xs text-neutral-200 focus:outline-none placeholder-neutral-600 font-mono"
        />
      </div>

      <!-- Dynamic File Tree Render Container -->
      <div id="fileTree" class="flex-1 overflow-y-auto p-2 font-mono text-xs space-y-1 select-none">
        <div class="text-center text-neutral-600 py-12">No archive loaded.</div>
      </div>
    </aside>

    <!-- Right Workspace: Preview & Extraction Pane (8 Cols) -->
    <section class="col-span-8 flex flex-col bg-neutral-950 overflow-hidden">
      
      <!-- Preview Bar Header -->
      <div class="px-6 py-3 border-b border-neutral-800 bg-neutral-900/20 flex items-center justify-between shrink-0 min-h-[49px]">
        <div class="flex items-center space-x-2 overflow-hidden">
          <i data-lucide="file-text" class="w-4 h-4 text-neutral-500 shrink-0"></i>
          <span id="previewPath" class="font-mono text-xs text-neutral-400 truncate">Select a file from the explorer to preview</span>
        </div>

        <button 
          id="extractBtn" 
          disabled 
          class="hidden flex items-center gap-1.5 bg-emerald-500 hover:bg-emerald-600 disabled:opacity-50 text-neutral-950 font-semibold px-3 py-1.5 rounded text-xs transition-colors"
        >
          <i data-lucide="download" class="w-3.5 h-3.5"></i>
          Extract File
        </button>
      </div>

      <!-- Main Preview Viewport -->
      <div id="previewArea" class="flex-1 overflow-auto p-6 flex flex-col items-center justify-center text-neutral-600">
        <i data-lucide="eye-off" class="w-10 h-10 mb-2 stroke-1"></i>
        <p class="text-xs font-mono">No active file selected for preview</p>
      </div>
    </section>

  </main>

  <script src="/js/app.js"></script>
</body>
</html>